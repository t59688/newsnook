# NewsNook Cloud 环境变量样例
# 复制成 cloud/.env 后填真实值。这个文件只列变量名，永远不要提交真实密钥。
#
# 生成随机值（示例）：
#   BETTER_AUTH_SECRET            openssl rand -base64 48
#   NEWSNOOK_DATA_ENCRYPTION_KEY  openssl rand -base64 32   # 必须正好解码成 32 字节

# ---- 必填 ----
# 外部 PostgreSQL（Docker Compose 不内置数据库）。
# 容器内不要写 localhost/127.0.0.1：
#   宿主机上的库 → postgres://USER:PASS@host.docker.internal:5432/DBNAME
#   远程托管库   → postgres://USER:PASS@db.example.com:5432/DBNAME
DATABASE_URL=
# 对外公网 API 根地址（必须与 Nginx server_name + https 一致）
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# AES-256-GCM 主密钥（base64 或 64 位 hex），只用于加密 user_secrets。
# 必须与 BETTER_AUTH_SECRET 不同，且与数据库备份分开保管——丢了它，Secret 密文无法恢复。
NEWSNOOK_DATA_ENCRYPTION_KEY=
# 允许携带凭证访问的前端来源，逗号分隔，不接受 *（是 Web App origin，不是 API 域名）
CLIENT_ORIGINS=

# ---- Docker 发布（Nginx 在另一台机时必改）----
# 宿主机监听地址：跨机反代用 0.0.0.0；仅本机 Nginx 可改 127.0.0.1
API_PUBLISH_HOST=0.0.0.0
# 宿主机端口（Nginx upstream 填「API机IP:这个端口」）
API_PUBLISH_PORT=8787
# 反代场景保持 true，限流才认 X-Forwarded-For
TRUST_PROXY=true

# ---- 可选：第三方登录（不填则该入口不出现）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Linux DO Connect：https://connect.linux.do
# 回调地址必须是 $BETTER_AUTH_URL/api/auth/callback/linuxdo
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# ---- 可选：邮件（不填则验证/重置邮件只写日志，仅适合本地开发）----
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- 可选：运行参数 ----
PORT=
HOST=
LOG_LEVEL=
REQUIRE_EMAIL_VERIFICATION=
