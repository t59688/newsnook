# Win / WSL 共用同一工作区：检出与入库统一 LF，避免假 diff、脚本 shebang 失败。
# 本机请保持 core.autocrlf=false（或 input），勿再开 true，否则会与本文件打架。
# 改完本文件后如需重整历史工作区换行：git add --renormalize .

# 默认：按内容识别文本，强制 LF（入库 + 检出）
* text=auto eol=lf

# Unix / shell 入口：必须 LF（后写覆盖上面的 *，避免被 text=auto 弱化）
*.sh text eol=lf
*.bash text eol=lf
android/gradlew text eol=lf
cloud/deploy text eol=lf

# Windows 批处理：cmd.exe 需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制：禁止换行转换；-eol 清掉上面 * 继承的 eol，避免 check-attr 噪音
*.png binary -eol
*.jpg binary -eol
*.jpeg binary -eol
*.gif binary -eol
*.webp binary -eol
*.ico binary -eol
*.jar binary -eol
*.aar binary -eol
*.apk binary -eol
*.so binary -eol
*.dll binary -eol
*.wasm binary -eol
*.woff binary -eol
*.woff2 binary -eol
*.ttf binary -eol
*.otf binary -eol
*.eot binary -eol
*.zip binary -eol
*.gz binary -eol
*.tgz binary -eol
*.7z binary -eol
*.pdf binary -eol
*.mp4 binary -eol
*.webm binary -eol
*.keystore binary -eol
*.jks binary -eol
