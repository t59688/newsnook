{
  "name": "@newsnook/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NewsNook 客户端与 cloud 服务共享的同步协议：DTO、Zod schema、稳定错误码。不含任何数据库或 ORM 实现。",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.1.14"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
